<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <title>Registration Form</title>
  </head>

  <body class="bg-light d-flex justify-content-center align-items-center min-vh-100">
    
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%">
      
      <h1 class="text-center fw-bold text-primary mb-3">HaiDoc! 🩺💊</h1>

      <div>
        <h2 class="h5 text-center mb-4 text-muted">
          Create your new account
        </h2>

        <% if (error) { %>
        <% error = error.split(";") %>
        <% error.forEach(err => { %>
          <p class="text-danger text-center mb-1"><%= err %></p>
        <% }) %>
        <% } %>

        <form action="/regist" method="post">
          <label for="name" class="form-label">Name</label>
          <input type="text" name="name" id="name" class="form-control mb-3" />

          <label for="email" class="form-label">Email</label>
          <input type="email" name="email" id="email" class="form-control mb-3" />

          <label for="password" class="form-label">Password</label>
          <input type="password" name="password" id="password" class="form-control mb-3" />

          <label for="role" class="form-label">Role</label>
          <input type="text" name="role" id="role" class="form-control mb-4" />

          <input
            type="submit"
            value="Sign Up"
            class="btn btn-primary w-100"
          />
        </form>
      </div>

      <a href="/login" class="text-center fw-bold text-primary mb-3 mt-2">Already have an account?</a>
    </div>

  </body>
</html>
