<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <title>Add Appointment</title>
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-primary px-4">
    <span class="navbar-brand fw-bold">HaiDoc 🩺💊</span>

    <div class="ms-auto d-flex gap-2">
      <a href="/patients/" class="btn btn-outline-light btn-sm">
        Home
      </a>
      <a href="/patients/<%= userId %>/profile" class="btn btn-outline-light btn-sm">
        My Profile
      </a>
      <a href="/logout" class="btn btn-outline-light btn-sm">
        Logout
      </a>
    </div>
  </nav>

  <div class="container mt-4">
    <h1 class="mb-4">Add Appointment</h1>

    <form action="/appointments/add" method="POST" class="card p-4 shadow-sm">
      <div class="mb-3">
        <label class="form-label">Patient</label>
        <select name="PatientId" class="form-select">
          <option value="<%= patients.id %>"><%= patients.name %></option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Doctor</label>
        <select name="DoctorId" class="form-select">
          <% doctors.forEach(d => { %>
            <option value="<%= d.id %>" <%= doctorId == d.id ? "selected" : "" %>>
              <%= d.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Complaint</label>
        <textarea name="complaint" class="form-control" rows="3"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Diseases</label>
        <div class="row">
          <% diseases.forEach(ds => { %>
            <div class="col-md-6">
              <div class="form-check">
                <input
                  type="checkbox"
                  class="form-check-input"
                  name="disease_id[]"
                  value="<%= ds.id %>"
                  id="disease-<%= ds.id %>"
                />
                <label class="form-check-label" for="disease-<%= ds.id %>">
                  <%= ds.name %>
                </label>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <a href="/appointments" class="btn btn-secondary">
          Back
        </a>
        <button type="submit" class="btn btn-primary">
          Submit
        </button>
      </div>
    </form>
  </div>

</body>
</html>
