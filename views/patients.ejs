<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient</title>
</head>
<body>
    <nav>
      <h1>HaiDok</h1>
      <h2>Welcome! </h2>
      <ul>
        <li>
          <a href="/patients/<%= userId %>/profile">My Profile</a>
        </li>
        <li>
          <a href="/patients/add">Add Patient</a>
        </li>
        <li>
          <a href="/logout">Logout</a>
        </li>
      </ul>
    </nav>

    <form method="get">
        <input type="text" name="search" placeholder="Search patient name">
        <button>Search</button>
    </form>

    <table border="1" cellpadding="5">
        <tr>
            <th>Name</th>
            <th>Gender</th>
            <th>Age</th>
        </tr>

            <% data.forEach(p => { %>
                <tr>
                    <td><%= p.name %></td>
                    <td><%= p.gender %></td>
                    <td><%= p.age %> years</td>
                </tr>
            <% }) %>
    </table>

    <br>
    <a href="/appointments">Go to Appointments</a>

    
</body>
</html>