<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HaiDoc | Cari Dokter</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    body {
      background: #f4f8fc;
    }
    .navbar {
      background: linear-gradient(90deg, #0d6efd, #4da3ff);
    }
    .doctor-card img {
      height: 160px;
      object-fit: contain;
      background: #eef5ff;
    }
    .specialist-badge {
      background: #e7f1ff;
      color: #0d6efd;
    }
  </style>
</head>

<body>


<nav class="navbar navbar-dark px-4">
  <span class="navbar-brand fw-bold">HaiDoc 🩺💊</span>

  <div class="ms-auto d-flex gap-2">
    <a href="/patients/<%= userId %>/profile" class="btn btn-outline-light btn-sm">
      My Profile
    </a>
    <a href="/logout" class="btn btn-outline-light btn-sm">
      Logout
    </a>
  </div>
</nav>


<div class="container my-5">

  <div class="text-center mb-4">
    <h2 class="fw-bold text-primary">Cari Jadwal Dokter</h2>
    <p class="text-muted">Cari berdasarkan nama dokter atau spesialis</p>
  </div>

  <!-- SEARCH FORM (SATU SAJA) -->
  <form method="get" class="mb-4">
  <div class="row g-2">
    <div class="col-md-9">
      <select name="specialist" class="form-select">
        <option value="all">Semua Spesialis</option>

        <% specialists.forEach(s => { %>
          <option 
            value="<%= s %>" 
            <%= selectedSpecialist === s ? 'selected' : '' %>
          >
            <%= s %>
          </option>
        <% }) %>

      </select>
    </div>

    <div class="col-md-3">
      <button class="btn btn-primary w-100">
        Cari Dokter
      </button>
    </div>
  </div>
</form>


  <div class="row g-4">

    <% if (doctors.length === 0) { %>
      <p class="text-center text-muted">
        Dokter tidak ditemukan 😔
      </p>
    <% } %>

    <% doctors.forEach(d => { %>
      <div class="col-md-3">
        <div class="card doctor-card shadow-sm h-100">

          <img
            src="/images/<%= d.photo %>"
            class="card-img-top p-3"
            alt="doctor"
          />

          <div class="card-body text-center">
            <h5 class="fw-bold"><%= d.name %></h5>

            <span class="badge specialist-badge mb-2">
              <%= d.specialist %>
            </span>

            <p class="mt-3 fw-semibold text-primary">
              Rp <%= d.price.toLocaleString('id-ID') %>
            </p>

            <a
              href="/appointments/add?doctorId=<%= d.id %>"
              class="btn btn-primary btn-sm w-100"
            >
              Konsultasi
            </a>
          </div>

        </div>
      </div>
    <% }) %>

  </div>
</div>

</body>
</html>
