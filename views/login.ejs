<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <title>Login | HaiDoc</title>

    <style>
      body {
        background: 
          linear-gradient(
            rgba(13, 110, 253, 0.2),
            rgba(13, 110, 253, 0.15)
          ),
          url("/images/hospital-bg.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }

      .login-card {
        border-radius: 16px;
        background: #ffffff;
      }

      .brand-title {
        letter-spacing: 1px;
      }
    </style>
  </head>

  <body class="d-flex justify-content-center align-items-center min-vh-100">

    <div class="card login-card shadow-lg p-4" style="max-width: 420px; width: 100%;">
      
      <div class="text-center mb-4">
        <h1 class="fw-bold text-primary brand-title">HaiDoc 🩺💊</h1>
        <p class="text-muted mb-0">
          Solusi konsultasi kesehatan terpercaya
        </p>
      </div>


      <% if (error) { %>
        <div class="alert alert-danger text-center">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">Email</label>
          <input 
            type="email" 
            name="email" 
            class="form-control"
            placeholder="Masukkan email"
            required
          />
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Password</label>
          <input 
            type="password" 
            name="password" 
            class="form-control"
            placeholder="Masukkan password"
            required
          />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
          Login
        </button>
      </form>

      <hr class="my-4" />

      <div class="text-center">
        <p class="text-muted mb-2">Belum punya akun?</p>
        <a href="/regist" class="btn btn-outline-primary w-100">
          Daftar Sekarang
        </a>
      </div>
    </div>

  </body>
</html>
