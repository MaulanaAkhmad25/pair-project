<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f8fb;
    }

    .navbar {
      background: #0d6efd;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }

    .navbar h2 {
      margin: 0;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-weight: bold;
    }

    .nav-links a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 500px;
      margin: 50px auto;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    h1 {
      text-align: center;
      color: #0d6efd;
      margin-bottom: 30px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      font-weight: bold;
      margin-bottom: 6px;
      display: block;
    }

    input[type="text"],
    input[type="date"] {
      width: 100%;
      padding: 9px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    .radio-group {
      display: flex;
      gap: 20px;
      margin-top: 5px;
    }

    .actions {
      margin-top: 30px;
      display: flex;
      justify-content: space-between;
    }

    button {
      padding: 10px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }

    .edit-btn {
      background: #0d6efd;
      color: white;
    }

    .save-btn {
      background: #198754;
      color: white;
    }

    .back-btn {
      background: #6c757d;
      color: white;
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 6px;
    }
  </style>
</head>
<body>


  <div class="navbar">
    <h2>HaiDoc 🩺💊</h2>
    <div class="nav-links">
      <a href="/patients">Home</a>
      <a href="/appointments">Appointments</a>
      <a href="/patients/<%= userProfile.UserId %>/profile">My Profile</a>
      <a href="/logout">Logout</a>
    </div>
  </div>


  <div class="container">
    <h1>My Profile</h1>

    <form action="/patients/<%= userProfile.UserId %>/profile" method="POST">

      <div class="form-group">
        <label>Name</label>
        <input
          type="text"
          name="name"
          value="<%= userProfile.name %>"
          <%= isEdit ? '' : 'readonly' %>
        >
      </div>

      <div class="form-group">
        <label>Gender</label>
        <div class="radio-group">
          <label>
            <input
              type="radio"
              name="gender"
              value="Pria"
              <%= userProfile.gender === 'Pria' ? 'checked' : '' %>
              <%= isEdit ? '' : 'disabled' %>
            > Pria
          </label>

          <label>
            <input
              type="radio"
              name="gender"
              value="Wanita"
              <%= userProfile.gender === 'Wanita' ? 'checked' : '' %>
              <%= isEdit ? '' : 'disabled' %>
            > Wanita
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>Date of Birth</label>
        <input
          type="date"
          name="dateOfBirth"
          value="<%= userProfile.dateOfBirth
            ? userProfile.dateOfBirth.toISOString().split('T')[0]
            : '' %>"
          <%= isEdit ? '' : 'readonly' %>
      >
      </div>

      <div class="actions">
        <% if (isEdit) { %>
          <button class="save-btn" type="submit">Save</button>
        <% } else { %>
          <a href="/patients/<%= userProfile.UserId %>/profile?edit=true">
            <button type="button" class="edit-btn">Edit Profile</button>
          </a>
        <% } %>

        <a href="/patients" class="back-btn">Back</a>
      </div>

    </form>
  </div>

</body>
</html>
