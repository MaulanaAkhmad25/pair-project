<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <title>My Profile</title>
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand bg-primary px-4">
    <span class="navbar-brand text-white fw-bold mb-0">
      HaiDoc 🩺💊
    </span>

    <div class="ms-auto d-flex gap-4">
      <a href="/patients" class="text-white fw-semibold text-decoration-none">
        Home
      </a>
      <a href="/appointments" class="text-white fw-semibold text-decoration-none">
        Appointments
      </a>
      <a
        href="/patients/<%= userProfile.UserId %>/profile"
        class="text-white fw-semibold text-decoration-none"
      >
        My Profile
      </a>
      <a href="/logout" class="text-white fw-semibold text-decoration-none">
        Logout
      </a>
    </div>
  </nav>

  <div class="container d-flex justify-content-center">
    <div
      class="card shadow-sm border-0 mt-5 p-4"
      style="max-width: 500px; width: 100%;"
    >
      <h1 class="text-center text-primary fw-bold mb-4">
        My Profile
      </h1>

      <form action="/patients/<%= userProfile.UserId %>/profile" method="POST">

        <div class="mb-3">
          <label class="form-label fw-bold">Name</label>
          <input
            type="text"
            name="name"
            class="form-control"
            value="<%= userProfile.name %>"
            <%= isEdit ? '' : 'readonly' %>
          >
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Gender</label>
          <div class="d-flex gap-4">
            <div class="form-check">
              <input
              id="pria"
                class="form-check-input"
                type="radio"
                name="gender"
                value="Pria"
                <%= userProfile.gender === 'Pria' ? 'checked' : '' %>
                <%= isEdit ? '' : 'disabled' %>
              >
              <label for="pria" class="form-check-label fw-semibold">
                Pria
              </label>
            </div>

            <div class="form-check">
              <input
              id="wanita"
                class="form-check-input"
                type="radio"
                name="gender"
                value="Wanita"
                <%= userProfile.gender === 'Wanita' ? 'checked' : '' %>
                <%= isEdit ? '' : 'disabled' %>
              >
              <label for="wanita" class="form-check-label fw-semibold">
                Wanita
              </label>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold">Date of Birth</label>
          <input
            type="date"
            name="dateOfBirth"
            class="form-control"
            value="<%= userProfile.dateOfBirth
              ? userProfile.dateOfBirth.toISOString().split('T')[0]
              : '' %>"
            <%= isEdit ? '' : 'readonly' %>
          >
        </div>

        <div class="d-flex justify-content-between mt-4">
          <% if (isEdit) { %>
            <button type="submit" class="btn btn-success px-4">
              Save
            </button>
          <% } else { %>
            <a href="/patients/<%= userProfile.UserId %>/profile?edit=true">
              <button type="button" class="btn btn-primary px-4">
                Edit Profile
              </button>
            </a>
          <% } %>

          <a href="/patients" class="btn btn-secondary px-4">
            Back
          </a>
        </div>

      </form>
    </div>
  </div>

</body>
</html>
