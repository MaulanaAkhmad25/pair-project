<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <title>My Appoinments</title>
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-primary px-4">
    <span class="navbar-brand fw-bold">HaiDoc 🩺💊</span>

    <div class="ms-auto d-flex gap-2">
      <a href="/patients/" class="btn btn-outline-light btn-sm">
        Home
      </a>
      <a href="/patients/<%= userId %>/profile" class="btn btn-outline-light btn-sm">
        My Profile
      </a>
      <a href="/logout" class="btn btn-outline-light btn-sm">
        Logout
      </a>
    </div>
  </nav>

  <div class="container mt-4">
    <h1 class="mb-4">My Appoinments</h1>

    <div class="mb-3">
      <a href="/appointments/add" class="btn btn-primary btn-sm">Add Appointment</a>
    </div>

    <form action="/appointments" method="get" class="card p-3 mb-4">
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label for="startDate" class="form-label">Start From</label>
          <input type="date" name="startDate" id="startDate" class="form-control" />
        </div>

        <div class="col-md-4">
          <label for="endDate" class="form-label">To</label>
          <input type="date" name="endDate" id="endDate" class="form-control" />
        </div>

        <div class="col-md-4">
          <input type="submit" value="Search" class="btn btn-success w-100" />
        </div>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle bg-white">
        <thead class="table-primary">
          <tr>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Status</th>
            <th>Date</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% data.forEach(el => { %>
            <tr>
              <td><%= el.Patient.name %></td>
              <td><%= el.Doctor.name %></td>
              <td>
                <span class="badge bg-info text-dark"><%= el.status %></span>
              </td>
              <td><%= formatDate(el.createdAt) %></td>
              <td>
                <a href="/appointments/<%= el.id %>" class="btn btn-sm btn-outline-primary">
                  Detail
                </a>
                <a
                  href="/appointments/<%= el.id %>/delete"
                  class="btn btn-sm btn-outline-danger ms-1"
                  onclick="return confirm('Are you sure?')"
                >
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>
